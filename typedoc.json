{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "docs/api/answer-steps.ts",
    "docs/api/async-guard.ts",
    "docs/api/choice.ts",
    "docs/api/math-text.ts",
    "docs/api/katex-engine.ts",
    "docs/api/clipboard-restore.ts",
    "docs/api/clipboard-formats.ts",
    "docs/api/react-katex.ts",
    "docs/api/react-markdown-math.ts",
    "docs/api/react-formula-input.ts",
    "docs/api/react-clipboard.ts",
    "docs/api/react-answer-steps.ts",
    "docs/api/react-choice.ts",
    "docs/api/mathlive-editor.ts",
    "docs/api/mathlive-formats.ts",
    "docs/api/tiptap-math.ts",
    "docs/api/core.ts",
    "docs/api/react.ts",
    "docs/api/adapter-mathlive.ts",
    "docs/api/adapter-mathlive-clipboard.ts",
    "docs/api/adapter-tiptap.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "out": "site-dist/api",
  "name": "EquaKit API",
  "includeVersion": true,
  "readme": "README.md",
  "alwaysCreateEntryPointModule": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "githubPages": true,
  "gitRevision": "main",
  "lang": "zh",
  "navigationLinks": {
    "在线 Playground": "https://leci-deeply.github.io/equakit/",
    "GitHub": "https://github.com/leci-deeply/equakit"
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": true,
    "includeFolders": false,
    "compactFolders": true,
    "excludeReferences": false
  }
}
