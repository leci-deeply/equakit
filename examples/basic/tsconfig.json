{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": "../..",
    "paths": {
      "@equakit/core": ["packages/core/src/index.ts"],
      "@equakit/react": ["packages/react/src/index.ts"],
      "@equakit/react/*": ["packages/react/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
