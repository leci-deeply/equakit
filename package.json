{
  "name": "equakit-workspace",
  "version": "0.1.0",
  "description": "EquaKit 数学富文本与答案编辑工具集",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "leci",
    "url": "https://github.com/leci-deeply"
  },
  "homepage": "https://github.com/leci-deeply/equakit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leci-deeply/equakit.git"
  },
  "bugs": {
    "url": "https://github.com/leci-deeply/equakit/issues"
  },
  "keywords": [
    "math",
    "latex",
    "katex",
    "markdown",
    "react",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "verify:packages": "node scripts/verify-packages.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^3.2.6"
  }
}
