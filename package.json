{
  "name": "equakit-workspace",
  "version": "0.1.0",
  "description": "EquaKit 数学富文本与答案编辑工具集",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "leci",
    "url": "https://github.com/leci-deeply"
  },
  "homepage": "https://github.com/leci-deeply/equakit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leci-deeply/equakit.git"
  },
  "bugs": {
    "url": "https://github.com/leci-deeply/equakit/issues"
  },
  "keywords": [
    "math",
    "latex",
    "katex",
    "markdown",
    "react",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tests/browser/tsconfig.json",
    "docs:check": "typedoc --options typedoc.json --emit none",
    "docs:api": "typedoc --options typedoc.json",
    "build:site": "node scripts/build-site.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "test": "vitest run",
    "test:visual": "playwright test tests/browser/katex.visual.spec.ts --project=chromium",
    "pretest:browser": "pnpm --filter @equakit/demo... build",
    "test:browser": "playwright test --project=chromium",
    "pretest:browser:all": "pnpm --filter @equakit/demo... build",
    "test:browser:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "pretest:browser:compat": "pnpm --filter @equakit/demo... build",
    "test:browser:compat": "playwright test --project=firefox --project=webkit",
    "verify:bundle": "node scripts/verify-bundle-budget.mjs",
    "verify:boundaries": "node scripts/verify-package-boundaries.mjs",
    "preverify:packages": "pnpm build",
    "verify:packages": "node scripts/verify-packages.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm docs:check && pnpm verify:boundaries && pnpm test && pnpm test:browser && pnpm build && pnpm verify:bundle && node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "typedoc": "^0.28.20",
    "vitest": "^3.2.6"
  }
}
