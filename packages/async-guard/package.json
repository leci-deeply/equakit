{
  "name": "@equakit/async-guard",
  "version": "0.1.0",
  "description": "按键版本与作用域匹配的异步过期响应保护工具",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "leci",
    "url": "https://github.com/leci-deeply"
  },
  "homepage": "https://github.com/leci-deeply/equakit/tree/main/packages/async-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leci-deeply/equakit.git",
    "directory": "packages/async-guard"
  },
  "bugs": {
    "url": "https://github.com/leci-deeply/equakit/issues"
  },
  "keywords": [
    "async",
    "stale",
    "mutation",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
