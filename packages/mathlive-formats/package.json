{
  "name": "@equakit/mathlive-formats",
  "version": "0.1.0",
  "description": "基于 MathLive 与 Compute Engine 的多格式数学剪贴板转换器",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "leci",
    "url": "https://github.com/leci-deeply"
  },
  "homepage": "https://github.com/leci-deeply/equakit/tree/main/packages/mathlive-formats#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leci-deeply/equakit.git",
    "directory": "packages/mathlive-formats"
  },
  "bugs": {
    "url": "https://github.com/leci-deeply/equakit/issues"
  },
  "keywords": [
    "math",
    "latex",
    "mathlive",
    "mathml",
    "asciimath",
    "mathjson",
    "clipboard"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --root ../.. packages/mathlive-formats/test"
  },
  "dependencies": {
    "@equakit/clipboard-formats": "workspace:^"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.58.0",
    "mathlive": "^0.110.0"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.58.0",
    "@equakit/clipboard-formats": "workspace:^",
    "mathlive": "^0.110.0"
  }
}
