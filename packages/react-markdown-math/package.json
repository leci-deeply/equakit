{
  "name": "@equakit/react-markdown-math",
  "version": "0.1.0",
  "description": "用于渲染 GFM 与数学内容的安全 React Markdown 组件",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "leci",
    "url": "https://github.com/leci-deeply"
  },
  "homepage": "https://github.com/leci-deeply/equakit/tree/main/packages/react-markdown-math#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leci-deeply/equakit.git",
    "directory": "packages/react-markdown-math"
  },
  "bugs": {
    "url": "https://github.com/leci-deeply/equakit/issues"
  },
  "keywords": [
    "math",
    "latex",
    "markdown",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@equakit/math-text": "workspace:^",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
