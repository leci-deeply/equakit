{
  "name": "@equakit/core",
  "version": "0.1.0",
  "description": "数学富文本归一化、校验、剪贴板恢复与答案编辑核心工具",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "leci",
    "url": "https://github.com/leci-deeply"
  },
  "homepage": "https://github.com/leci-deeply/equakit/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leci-deeply/equakit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/leci-deeply/equakit/issues"
  },
  "keywords": [
    "math",
    "latex",
    "katex",
    "markdown",
    "clipboard",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --root ../.. packages/core/test"
  },
  "dependencies": {
    "@equakit/answer-steps": "workspace:^",
    "@equakit/async-guard": "workspace:^",
    "@equakit/choice": "workspace:^",
    "@equakit/clipboard-formats": "workspace:^",
    "@equakit/clipboard-restore": "workspace:^",
    "@equakit/katex-engine": "workspace:^",
    "@equakit/math-text": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  }
}
