{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@equakit/answer-steps": ["packages/answer-steps/src/index.ts"],
      "@equakit/async-guard": ["packages/async-guard/src/index.ts"],
      "@equakit/choice": ["packages/choice/src/index.ts"],
      "@equakit/math-text": ["packages/math-text/src/index.ts"],
