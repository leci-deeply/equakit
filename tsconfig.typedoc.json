      "@equakit/clipboard-restore": ["packages/clipboard-restore/src/index.ts"],
      "@equakit/clipboard-formats": ["packages/clipboard-formats/src/index.ts"],
      "@equakit/react-katex": ["packages/react-katex/src/index.ts"],
      "@equakit/react-markdown-math": ["packages/react-markdown-math/src/index.ts"],
      "@equakit/react-formula-input": ["packages/react-formula-input/src/index.ts"],
      "@equakit/react-clipboard": ["packages/react-clipboard/src/index.ts"],
